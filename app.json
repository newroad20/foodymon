{
  "expo": {
    "name": "foodymon",
    "slug": "foodymon",
    "owner": "newroad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodymon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.foodymon.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF5F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.foodymon.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF5F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e591e60-4305-44f8-9ad5-c379ba2c3964"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e591e60-4305-44f8-9ad5-c379ba2c3964"
    }
  }
}
